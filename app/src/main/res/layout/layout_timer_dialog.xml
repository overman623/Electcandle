<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:id="@+id/layout_dialog_timer"
    >

    <RelativeLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Timer Setting"
            android:textColor="#ffffff"
            android:textSize="20dp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_alignBottom="@+id/btn_back_arrow"
            />
        <Button
            android:id="@+id/btn_back_arrow"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentLeft="true"
            android:background="@null"
            />

    </RelativeLayout>



    <LinearLayout
        android:id="@+id/layout_setting_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@+id/layout_header"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Play\nTime"
            android:textColor="#ffffff"
            android:lines="2"
            android:textSize="30dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerHorizontal="true"
            >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <NumberPicker
                    android:id="@+id/picker_hour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@android:style/Theme.Holo.Light"
                    android:background="@color/white"
                    />

                <NumberPicker
                    android:id="@+id/picker_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@android:style/Theme.Holo.Light"
                    android:background="@color/white"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    />

                <NumberPicker
                    android:id="@+id/picker_sec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@android:style/Theme.Holo.Light"
                    android:background="@color/white"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                >

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="시"
                    android:textAlignment="center"
                    android:textColor="#ffffff"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="분"
                    android:textAlignment="center"
                    android:textColor="#ffffff"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="초"
                    android:textAlignment="center"
                    android:textColor="#ffffff"
                    />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_setting_breath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@+id/layout_setting_time"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Breath \nSetting"
                android:textColor="#ffffff"
                android:textSize="30dp"
                android:lines="2"
                android:textAlignment="center"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="15dp"
                android:layout_gravity="center_vertical"
                />
            <CheckBox
                android:id="@+id/check_breath"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="호흡기능"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:layout_marginBottom="10dp"/>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <NumberPicker
                    android:id="@+id/picker_breath_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@android:style/Theme.Holo.Light"
                    android:background="@color/white"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="초"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center_vertical"
                >

                <TextView
                    android:id="@+id/text_breath_percent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="@color/white"
                    android:textAlignment="center"
                    android:textSize="60dp"
                    />

                <SeekBar
                    android:id="@+id/seek_breath_percent"
                    android:layout_width="180dp"
                    android:layout_height="30dp"
                    android:progress="50"
                    android:max="100"
                    android:min="0"
                    />

                <RelativeLayout
                    android:layout_width="200dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inhole"
                        android:textColor="@color/white"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exhole"
                        android:textColor="@color/white"
                        android:layout_alignParentRight="true"
                        />

                </RelativeLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_below="@+id/layout_setting_breath"
        android:paddingLeft="20dp"
        >

        <CheckBox
            android:id="@+id/check_bell_sound"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="종소리"
            android:textColor="@color/white"
            android:layout_marginBottom="10dp"
            />

        <CheckBox
            android:id="@+id/check_breath_ready"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="예비 호흡시간"
            android:textColor="@color/white"
            android:checked="false"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layout_check"
        android:orientation="horizontal"
        android:gravity="center"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시작"
                android:textColor="@color/white"
                android:layout_gravity="center"
                />

            <EditText
                android:id="@+id/edit_breath_start_percent"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:inputType="number"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%"
                android:textColor="@color/white"
                android:layout_gravity="center"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="증가"
                android:textColor="@color/white"
                android:layout_gravity="center"
                />

            <EditText
                android:id="@+id/edit_breath_increase_percent"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:inputType="number"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%"
                android:textColor="@color/white"
                android:layout_gravity="center"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="각"
                android:textColor="@color/white"
                android:layout_gravity="center"
                />

            <Spinner
                android:id="@+id/spinner_breath_time"
                android:layout_width="80dp"
                android:layout_height="50dp"
                android:entries="@array/breath_time"
                android:layout_gravity="center"
                android:gravity="end"
                android:spinnerMode="dropdown"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회"
                android:textColor="@color/white"
                android:layout_gravity="center"
                />

        </LinearLayout>

    </LinearLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:layout_marginBottom="30dp"
        >

        <Button
            android:id="@+id/timer_cancel"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="취소"
            android:textSize="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/timer_save"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/timer_save"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="적용"
            android:textSize="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/timer_cancel" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</RelativeLayout>